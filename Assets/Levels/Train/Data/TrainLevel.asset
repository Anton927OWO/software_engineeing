  levelId: Train
  displayName: "\u5C0B\u8DE1\u5B9C\u5927\uFF5C\u77E5\u8B58\u5217\u8ECA"
  durationSeconds: 60
  mistakeLimit: 0
  introductionTitle: "\u77E5\u8B58\u5217\u8ECA\uFF5C\u6821\u53F2\u8ECA\u7AD9"
  introductionBody: "\u6B61\u8FCE\u4F86\u5230\u6821\u53F2\u77E5\u8B58\u8ECA\u7AD9\u3002\u5217\u8ECA\u5C07\u5E36\u4F60\u8A8D\u8B58\u5B9C\u5927\u7684\u6210\u9577\u8DB3\u8DE1\u3002\n\n\u5728
    60 \u79D2\u5167\u56DE\u7B54\u4E09\u9078\u4E00\u984C\u76EE\uFF0C\u7B54\u5C0D\u63A5\u4E0A\u4E00\u7BC0\u8ECA\u5EC2\uFF0C\u96C6\u6EFF\u4E94\u7BC0\u4E26\u958B\u51FA\u756B\u9762\u5373\u53EF\u901A\u95DC\u3002\n\u7B54\u932F\u6703\u986F\u793A\u6B63\u89E3\u4E00\u79D2\u4E26\u8A18\u9304\u5931\u8AA4\uFF1B\u540C\u4E00\u8F2A\u984C\u76EE\u4E0D\u91CD\u8907\u3002\u6642\u9593\u5230\u6216\u984C\u76E1\u672A\u9054\u6A19\u5C31\u6311\u6230\u5931\u6557\u3002\n\n\u77E5\u8B58\u5361\u53EF\u95B1\u8B80\u89E3\u8AAA\u8207\u5B98\u65B9\u4F86\u6E90\uFF1B\u4ECB\u7D39\u3001\u77E5\u8B58\u5361\u53CA\u66AB\u505C\u6642\u4E0D\u6263\u79D2\u3002\u63A5\u8ECA\u8207\u51FA\u7AD9\u52D5\u756B\u4ECD\u8A08\u6642\uFF0C\u8ACB\u628A\u63E1\u6642\u9593\uFF01"
  introductionImage: {fileID: 0}
  showIntroduction: 1
