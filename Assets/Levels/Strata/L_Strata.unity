MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 561457336}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22b6b35dbcc94122a98db837e579cb05, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  knowledgeCatalog: {fileID: 11400000, guid: 348f8fa343e142909c5a843b5507f8f8, type: 2}
  knowledgePages:
  - title: "\u78DA\u74E6\u6B98\u7247"
    image: {fileID: 21300000, guid: 351114fc14c2eee45a886d95bd7857ca, type: 3}
    body: "\u8868\u571F\u5C64\u5E38\u898B\u78DA\u74E6\u7B49\u8FD1\u4EE3\u907A\u7559\u3002\n\u5806\u7A4D\u571F\u5C64\u4E5F\u53EF\u80FD\u767C\u73FE\u96F6\u661F\u9676\u7247\u3001\u74E6\u7247\u8207\u73BB\u7483\u73E0\u3002\n\u6587\u7269\u907A\u7559\u80FD\u5E6B\u52A9\u6211\u5011\u8A8D\u8B58\u904E\u53BB\u7684\u751F\u6D3B\u8207\u6D3B\u52D5\u3002"
    source: "\u570B\u7ACB\u5B9C\u862D\u5927\u5B78\u5716\u66F8\u8CC7\u8A0A\u9928\uFF5C\u5B9C\u862D\u8FB2\u6821\u907A\u5740\nhttps://lic.niu.edu.tw/p/404-1010-71228.php\nhttps://lic.niu.edu.tw/p/412-1010-2280.php"
  - title: "\u73BB\u7483\u73E0"
    image: {fileID: 21300000, guid: 3e7b6d6117ea1ff43a2a675315552b90, type: 3}
    body: "\u73BB\u7483\u73E0\u662F\u820A\u793E\u6587\u5316\u6642\u671F\u5E38\u898B\u7684\u88DD\u98FE\u54C1\u4E4B\u4E00\u3002\n\u5B9C\u862D\u8FB2\u6821\u907A\u5740\u4E5F\u51FA\u571F\u904E\u5404\u5F0F\u73E0\u98FE\u3002\n\u9019\u4E9B\u6587\u7269\u53CD\u6620\u4E86\u7576\u6642\u4EBA\u5011\u7684\u88DD\u98FE\u6587\u5316\u8207\u4EA4\u6D41\u6D3B\u52D5\u3002"
    source: "\u570B\u7ACB\u5B9C\u862D\u5927\u5B78\u5716\u66F8\u8CC7\u8A0A\u9928\uFF5C\u5B9C\u862D\u8FB2\u6821\u907A\u5740\nhttps://lic.niu.edu.tw/p/404-1010-71228.php\nhttps://lic.niu.edu.tw/p/412-1010-2280.php"
  - title: "\u5370\u7D0B\u9676\u7247"
    image: {fileID: 21300000, guid: a8857569cc320234b8dd2ea793c4a3bb, type: 3}
    body: "\u5370\u7D0B\u9676\u5668\u662F\u820A\u793E\u6587\u5316\u5177\u6709\u4EE3\u8868\u6027\u7684\u6587\u7269\u3002\n\u9676\u5668\u8868\u9762\u7684\u7D0B\u98FE\u5C55\u73FE\u7576\u6642\u7684\u88FD\u9676\u6280\u8853\u8207\u751F\u6D3B\u6587\u5316\u3002\n\u900F\u904E\u9676\u7247\u53EF\u4EE5\u66F4\u4E86\u89E3\u7576\u6642\u4EBA\u5011\u7684\u65E5\u5E38\u751F\u6D3B\u3002"
    source: "\u570B\u7ACB\u5B9C\u862D\u5927\u5B78\u5716\u66F8\u8CC7\u8A0A\u9928\uFF5C\u5B9C\u862D\u8FB2\u6821\u907A\u5740\nhttps://lic.niu.edu.tw/p/404-1010-71228.php\nhttps://lic.niu.edu.tw/p/412-1010-2280.php"
