  levelId: Finale
  displayName: "\u7D42\u7AE0\uFF5C\u6587\u7269\u8A18\u61B6\u7FFB\u724C"
  durationSeconds: 90
  mistakeLimit: 0
  introductionTitle: "\u7D42\u7AE0\u7A7A\u9593\uFF5C\u627E\u56DE\u6587\u7269\u8A18\u61B6"
  introductionBody: "\u8D70\u9032\u6587\u7269\u5C55\u793A\u7A7A\u9593\uFF0C\u900F\u904E\u5F62\u72C0\u3001\u6750\u8CEA\u8207\u7D0B\u6A23\uFF0C\u628A\u63A2\u7D22\u7684\u8A18\u61B6\u9023\u7D50\u8D77\u4F86\u3002\n\n\u958B\u59CB\u6642\u5148\u7528
    2 \u79D2\u8A18\u4F4F\u672C\u5C40\u53D6\u5F97\u7684\u4E09\u4EF6\u6587\u7269\uFF0C\u63D0\u793A\u7D50\u675F\u5F8C\u624D\u958B\u59CB
    90 \u79D2\u5012\u6578\u3002\n\n\u724C\u684C\u5171\u6709 4 \xD7 3 \u5F35\u724C\u3001\u516D\u7A2E\u6587\u7269\u5404\u5169\u5F35\u3002\u6BCF\u6B21\u7FFB\u5169\u5F35\uFF1B\u76F8\u540C\u5C31\u4FDD\u7559\u4E26\u4EAE\u8D77\u91D1\u6846\uFF0C\u4E0D\u540C\u5247\u7B49\u5F85
    0.8 \u79D2\u7FFB\u56DE\u4E26\u8A18\u9304\u4E00\u6B21\u5931\u8AA4\u3002\u5B8C\u6210\u516D\u7D44\u5373\u53EF\u901A\u95DC\u3002\n\n\u53EF\u95B1\u8B80\u77E5\u8B58\u5361\u3001\u66AB\u505C\u6216\u91CD\u65B0\u958B\u59CB\uFF1B\u95B1\u8B80\u8207\u66AB\u505C\u6642\u4E0D\u6263\u6642\u9593\u3002\u5716\u50CF\u70BA\u6587\u7269\u793A\u610F\u5716\u3002"
  introductionImage: {fileID: 290658076908743098, guid: 847e17a6ad766492eb2a4fed84278210, type: 3}
